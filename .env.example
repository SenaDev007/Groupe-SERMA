# ─── Base distante PostgreSQL Neon (SermaHub) ─────────────────
# URL du pooler (transactionsPgBouncer) utilisée par l'application
SERMAHUB_DATABASE_URL=postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx-pooler.region.aws.neon.tech/SermaHub?sslmode=require&pgbouncer=true
# URL directe utilisée par Prisma Migrate / scripts d'administration
SERMAHUB_DIRECT_URL=postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx.region.aws.neon.tech/SermaHub?sslmode=require

# ─── Session back-office ─────────────────────────────────────
BO_SESSION_SECRET=chaine-aleatoire-longue-et-secrète

# ─── Envoi d'e-mails (Resend) — optionnel ────────────────────
RESEND_API_KEY=
RESEND_TO_EMAIL=

# ─── Google Analytics 4 — optionnel ──────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ─── Scripts d'administration (voir scripts/) ────────────────
# scripts/update-credentials.js
BO_ADMIN_EMAIL=
BO_ADMIN_PASSWORD=
BO_ADMIN_NAME=
# scripts/seed-back-office.ts
SEED_ADMIN_PASSWORD=
